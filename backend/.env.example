# Development defaults.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
SECRET_KEY=replace-with-at-least-32-random-characters

FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=plutus_access_token
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# Email verification is optional for local development and mandatory in production.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_DELIVERY_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Plutus
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
BREVO_API_KEY=

# AI insights.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_STORE_RESPONSES=false

# Production checklist:
# ENVIRONMENT=production
# FRONTEND_ORIGIN=https://your-domain.example
# ALLOWED_ORIGINS=https://your-domain.example
# ALLOWED_HOSTS=your-api-host.example
# AUTH_COOKIE_SECURE=true
# EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_DELIVERY_PROVIDER=brevo_api
# SMTP_FROM_EMAIL=2sicilies@gmail.com
# BREVO_API_KEY=<transactional email API key>
# SECRET_KEY=<long random secret from a secret manager>
